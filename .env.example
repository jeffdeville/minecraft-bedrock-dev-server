# Lives ON THE SERVER as /opt/mc/app/.env, read by docker-compose and deploy.sh.
# bin/deploy.sh seeds it from this file on the first deploy; after that edit it
# there (mc ssh). It is never rsynced, and .env is gitignored.

# --- Which BDS build to run -------------------------------------------------
# Pin the image so a surprise upstream change can't break the server mid-session.
# Bump deliberately; see README "Updating Minecraft".
BEDROCK_IMAGE_TAG=2026.8.1

# BDS version inside the image. deploy.sh pins this to an exact version (the
# running one, or today's release on a fresh box) so a deploy never changes the
# game version by accident; after that only `mc update` changes it. LATEST here
# only means "pin whatever is current on the first deploy".
VERSION=LATEST

# --- Server identity --------------------------------------------------------
SERVER_NAME="Dev Server"
LEVEL_NAME=devworld
GAMEMODE=creative
DIFFICULTY=easy
ALLOW_CHEATS=true
MAX_PLAYERS=10
VIEW_DISTANCE=12

# Requires players to sign in with a real Xbox Live account. Keep this true --
# false lets anyone who finds your IP join under any name.
ONLINE_MODE=true

# Set to true and populate data/allowlist.json to restrict who can join.
# See README "Locking down who can join".
ALLOW_LIST=false

# --- Deploy behaviour -------------------------------------------------------
# restart = stop and start BDS. Always correct, ~15s, disconnects players.
# reload  = send /reload to the running server. ~2s, players stay connected,
#           but the Script API leaks event subscriptions across reloads, so
#           long sessions drift. Use it for tight iteration, restart when
#           behaviour gets weird.
RELOAD_MODE=restart

# --- Updates ----------------------------------------------------------------
# Nightly check for a new BDS release: backup the world, warn players, pin the
# new version, restart, verify, roll back on failure. Bedrock clients
# auto-update within a day and refuse an older server, so lagging behind only
# produces "Outdated server" for the players. Run it by hand with `mc update`.
AUTO_UPDATE=true
# Server time is UTC; 08:00 UTC is 04:00 US Eastern.
UPDATE_CRON="0 8 * * *"
# World tarballs kept in backups/ on the server (one is taken before every upgrade).
BACKUP_KEEP=10

# --- Log viewer -------------------------------------------------------------
LOG_PORT=8080

# Leave empty for a public log page (anyone with the URL can read the console).
# Set to user:password to require HTTP basic auth instead.
LOG_AUTH=
