# Lives ON THE COURSE BOX as /opt/redstone/.env. bootstrap.sh seeds it from
# this file once and fills the generated values; after that edit it there.
# Never rsynced, never committed.

# Where everything lives. bootstrap.sh sets it.
ROOT=

# Caddy's site address. bootstrap.sh sets http://<ip> so the box works before
# DNS exists; change to https://redstone.clny.dev once the A record points
# here and Caddy will fetch a certificate on the next restart.
SITE=

# Admin login on the dashboard. Generated if empty.
ADMIN_PASSWORD=
# Cookie signing key. Generated if empty; changing it logs everyone out.
SECRET=

# --- Learner servers ----------------------------------------------------------
# itzg image tag, pinned on purpose.
BEDROCK_IMAGE_TAG=2026.8.2
# BDS version for new learners. LATEST is resolved to a concrete version when a
# learner is provisioned and written to their own .env, so a server never
# upgrades under a learner. Bump it here for new learners; existing learners
# keep theirs until their .env changes.
BDS_VERSION=LATEST
# Memory cap per learner server. 1g fits an idle-to-one-player world on x86;
# world creation under emulation (a dev laptop) needs 3g.
BDS_MEMORY=1g
# Learner n (0-based) gets FIRST_PORT + 10n for IPv4 and +1 for IPv6.
FIRST_PORT=19132
# Seconds of quiet after a save before the sidecar deploys.
SETTLE=2
