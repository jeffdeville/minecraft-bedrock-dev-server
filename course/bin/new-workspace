#!/usr/bin/env python3
"""new-workspace DIR

Create a learner workspace: the template, a copy of every lesson, a git
repository with one commit, and the solution tags. The platform's
provisioner runs this; so does anyone testing lessons on a laptop.
"""

import subprocess
import sys
from pathlib import Path

from courselib import COURSE, die, git, stage_workspace


def main(argv):
    if len(argv) != 1 or argv[0].startswith("-"):
        die(__doc__.strip())
    ws = Path(argv[0]).resolve()
    if ws.exists() and any(ws.iterdir()):
        die(f"{ws} exists and is not empty")
    stage_workspace(ws)
    git(ws, "init", "-q", "-b", "main")
    git(ws, "add", "-A")
    git(ws, "commit", "-q", "-m", "Course workspace")
    subprocess.run([sys.executable, str(COURSE / "bin" / "build-tags"), str(ws)], check=True)
    print(f"workspace ready at {ws}")
    print(f"  cd {ws} && PATH={COURSE / 'bin'}:$PATH lesson")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
